# ---------------------------------------------------------------------------
# AI Study Assistant — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Scope: local, single-user (REQUIREMENTS.md §2.4).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- API service (apps/api) ------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Web client (apps/web) -------------------------------------------------
# NEXT_PUBLIC_* is exposed to the browser. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Postgres (T-002, T-004) -----------------------------------------------
POSTGRES_USER=aistudy
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aistudy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aistudy:change-me-locally@localhost:5432/aistudy

# --- Redis (T-002, T-008) --------------------------------------------------
# Broker only. Celery's result backend is deliberately unset: the GenerationJob
# row in Postgres is the job record (TD §3.1, T-008).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Object storage — MinIO locally, S3-compatible (T-002, T-009) ----------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-locally
S3_BUCKET_SOURCES=aistudy-sources
S3_BUCKET_ARTIFACTS=aistudy-artifacts
# Traces live in their OWN bucket and are the most-missed item in a deletion
# cascade (TD §9.2, T-135). Keep it separate on purpose.
S3_BUCKET_TRACES=aistudy-traces

# --- Anthropic (T-010) -----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# X2: model IDs come from config, never a string literal, never date-suffixed.
ANTHROPIC_MODEL=claude-opus-5

# --- Single-user auth (REQUIREMENTS.md §2.4, T-006) ------------------------
# One seeded dev user. The Bearer header stays required on every route so the
# API contract is unchanged the day real authentication arrives.
DEV_USER_ID=usr_local_dev
DEV_USER_EMAIL=dev@localhost
DEV_USER_TOKEN=local-dev-token-change-me

# --- TTS (Phase 3) ---------------------------------------------------------
# Vendor is undecided — T-301 runs the bake-off and resolves D1/Q1/Q9.
# Variables are added here once a vendor is chosen.
